# Example nginx reverse-proxy config for pkgd. TLS termination and public
# HTTP surface live here; pkgd itself only speaks plain HTTP over a Unix
# socket and is never exposed directly.

upstream pkgd {
    server unix:/run/pkgd/pkgd.sock;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name pkgs.merelinux.org;

    ssl_certificate     /etc/letsencrypt/live/pkgs.merelinux.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pkgs.merelinux.org/privkey.pem;

    # Package publishes can be large batches of archives; raise the body
    # size limit accordingly. Adjust to your actual expected batch size.
    client_max_body_size 512m;

    location / {
        proxy_pass http://pkgd;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Preserve Range request support for resumable downloads.
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name pkgs.merelinux.org;
    return 301 https://$host$request_uri;
}
