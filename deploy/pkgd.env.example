# Example environment file for pkgd.
# Copy to /etc/pkgd/pkgd.env, fill in real values, and `chmod 600` it
# (it contains the publish bearer token).

# --root prefix for every `mere` invocation pkgd makes. The persistent dev
# repo (sole source of truth for publishing; accumulates every package
# ever published through pkgd) is resolved from this by mere itself as
# <PKGD_MERE_ROOT>/mere/dev/repo/<PKGD_DEV_REPO_NAME>/ - pkgd deliberately
# never invents that path itself, since `mere dev import` only
# auto-bootstraps a dev repo addressed this way (by --root + name), not by
# an arbitrary absolute path.
PKGD_MERE_ROOT=/var/lib/pkgd

# Bare name of the dev repo under PKGD_MERE_ROOT. Optional, defaults to
# "pkgd".
PKGD_DEV_REPO_NAME=pkgd

# Production output directory: what pkgd serves read-only over HTTP.
# Entirely owned by `mere release publish` - pkgd never writes here
# directly.
PKGD_OUTPUT_DIR=/srv/pkgs

# Path to the mere binary.
PKGD_MERE_BIN=/usr/local/bin/mere

# Path to the repo signing key. Optional - omit to publish unsigned.
# pkgd only ever reads this path (passes it through to `mere release
# publish --key`); it does not create, rotate, or otherwise manage it.
PKGD_SIGNING_KEY_PATH=/etc/pkgd/signing.key

# Bearer token CI must present to POST /publish. Treat as a secret.
PKGD_PUBLISH_TOKEN=change-me

# Unix socket pkgd listens on; nginx proxies to this.
PKGD_LISTEN_SOCKET=/run/pkgd/pkgd.sock

# Where uploaded archives are staged before being handed to `mere dev
# import`. Defaults to the OS temp dir if unset.
PKGD_TEMP_DIR=/var/lib/pkgd/tmp
